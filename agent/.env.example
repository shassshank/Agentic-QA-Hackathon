# Copy to agent/.env and fill in. agent/.env is gitignored; never commit real keys.

# LLM provider used by the QA agent: gemini (default) or claude
QA_LLM_PROVIDER=gemini

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model ids: planner = one-time PRD interpretation/planning, fast = recovery and judge calls.
# Confirmed against the Gemini API model list on 2026-10-20.
GEMINI_MODEL_PLANNER=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Optional: only needed for the Claude cost-comparison run
ANTHROPIC_API_KEY=

# Target under test (local DemoBank by default; replace with the hosted URL when available)
QA_TARGET_URL=http://localhost:5173

# Tried in order when a model returns 503 (overloaded) or 429 (rate limited)
GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.1-pro-preview
